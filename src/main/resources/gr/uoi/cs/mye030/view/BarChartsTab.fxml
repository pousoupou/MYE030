<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="gr.uoi.cs.mye030.view.BarChartsTabController"
      spacing="10.0" styleClass="barcharts-tab">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <HBox spacing="6" alignment="CENTER_LEFT">
        <Label text="Mode:"/>
        <fx:define>
            <ToggleGroup fx:id="modeGroup"/>
        </fx:define>
        <ToggleButton fx:id="journalsToggle" text="Journals" toggleGroup="$modeGroup" selected="true"/>
        <ToggleButton fx:id="conferencesToggle" text="Conferences" toggleGroup="$modeGroup"/>
    </HBox>

    <Label text="Per-entity stats" styleClass="profile-section"/>
    <HBox spacing="10" VBox.vgrow="ALWAYS">
        <VBox spacing="6" prefWidth="280" minWidth="240">
            <TextField fx:id="entitySearchField" promptText="Search..."/>
            <ListView fx:id="entityListView" VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Total articles" styleClass="profile-section"/>
            <StackPane fx:id="totalArticlesChartContainer" minHeight="240" VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Avg articles per year" styleClass="profile-section"/>
            <StackPane fx:id="avgArticlesChartContainer" minHeight="240" VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Avg authors per year" styleClass="profile-section"/>
            <StackPane fx:id="avgAuthorsChartContainer" minHeight="240" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>

    <Label text="Distinct journals per quarter, by publisher (journals only)" styleClass="profile-section"/>
    <HBox spacing="10" VBox.vgrow="ALWAYS">
        <VBox spacing="6" prefWidth="280" minWidth="240">
            <TextField fx:id="publisherSearchField" promptText="Search publishers..."/>
            <ListView fx:id="publisherListView" VBox.vgrow="ALWAYS"/>
        </VBox>
        <StackPane fx:id="publisherChartContainer" HBox.hgrow="ALWAYS" minHeight="240"/>
    </HBox>
</VBox>
